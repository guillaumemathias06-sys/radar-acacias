# Supabase — projet dédié à Radar (dans une organisation séparée de Jarvis,
# pour ne pas partager le quota de transfert du plan gratuit).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Clé de chiffrement des secrets (identifiants Playtomic) : 32 octets en base64.
#   openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=

# Secret du cron Vercel (Playtomic quotidien).
CRON_SECRET=

# Secret partagé entre le collecteur Moja (sur le Mac) et Radar.
INGEST_SECRET=

# Utilisé par le collecteur Moja : adresse de Radar (prod ou http://localhost:3000).
RADAR_URL=
