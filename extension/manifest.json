{
  "manifest_version": 3,
  "name": "Radar — Moja",
  "version": "1.0.0",
  "description": "Envoie à Radar, en lecture seule, les tournois que tu consultes toi-même sur Moja.",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": ["https://moja.fft.fr/*", "https://radar-acacias.vercel.app/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Envoyer à Radar" },
  "options_page": "options.html"
}
